<Project Sdk="Nice3point.Revit.Sdk/6.1.2">

    <PropertyGroup>
        <UseWPF>true</UseWPF>
        <Version>1.0.0</Version>

        <!-- Usings are written out in every file so a reader never has to guess where a type comes from. -->
        <ImplicitUsings>false</ImplicitUsings>
        <ImplicitRevitUsings>false</ImplicitRevitUsings>

        <!-- Loads the add-in into its own context on Revit 2025 and later, so its assemblies
             cannot collide with another add-in that ships a different version of the same file. -->
        <EnableDynamicLoading>true</EnableDynamicLoading>

        <!-- The SDK reads the version suffix of the configuration and picks the target framework:
             R23 and R24 build against net48, R25 and R26 against net8.0-windows. -->
        <Configurations>Debug.R23;Debug.R24;Debug.R25;Debug.R26</Configurations>
        <Configurations>$(Configurations);Release.R23;Release.R24;Release.R25;Release.R26</Configurations>
    </PropertyGroup>

    <ItemGroup>
        <!-- Revit API reference assemblies. They are reference only, nothing is copied to the
             output, so the installer ships a single DLL with no third party dependencies. -->
        <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*"/>
        <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*"/>
    </ItemGroup>

    <ItemGroup>
        <Resource Include="Resources\Icons\RibbonIcon16.png"/>
        <Resource Include="Resources\Icons\RibbonIcon32.png"/>
    </ItemGroup>

</Project>
