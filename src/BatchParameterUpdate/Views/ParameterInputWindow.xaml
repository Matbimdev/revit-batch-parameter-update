<Window x:Class="BatchParameterUpdate.Views.ParameterInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Batch Parameter Update"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="White">

    <Window.Resources>
        <!-- The only styled control in the add-in. Everything else stays on the stock WPF
             look, which is what a Revit user expects from a small utility dialog. -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#C05621"/>
            <Setter Property="Padding" Value="18,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="#A8481B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="#8C3B15"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Body" Property="Background" Value="#D9D9D9"/>
                                <Setter Property="Foreground" Value="#8A8A8A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- Button strip -->
        <Border DockPanel.Dock="Bottom"
                Background="#F3F3F3"
                BorderBrush="#DDDDDD"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="UpdateButton"
                        Content="Update"
                        Style="{StaticResource PrimaryButton}"
                        IsDefault="True"
                        IsEnabled="False"
                        Click="OnUpdateClick"/>
                <Button Content="Cancel"
                        Margin="8,0,0,0"
                        Padding="18,5"
                        IsCancel="True"/>
            </StackPanel>
        </Border>

        <StackPanel Margin="16">
            <TextBlock x:Name="ScopeText"
                       Foreground="#555555"
                       TextWrapping="Wrap"
                       Margin="0,0,0,14"/>

            <TextBlock Text="Parameter name" Margin="0,0,0,4"/>
            <TextBox x:Name="ParameterNameBox"
                     Padding="4,3"
                     TextChanged="OnInputChanged"/>
            <TextBlock Text="Written exactly as it appears in Revit, including capitals."
                       FontSize="11"
                       Foreground="#777777"
                       Margin="0,4,0,14"/>

            <TextBlock Text="New value" Margin="0,0,0,4"/>
            <TextBox x:Name="NewValueBox" Padding="4,3"/>
            <TextBlock Text="Leave empty to clear the parameter."
                       FontSize="11"
                       Foreground="#777777"
                       Margin="0,4,0,0"/>
        </StackPanel>

    </DockPanel>
</Window>
