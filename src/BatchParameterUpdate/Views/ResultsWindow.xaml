<Window x:Class="BatchParameterUpdate.Views.ResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Batch Parameter Update"
        Width="480"
        MinWidth="380"
        SizeToContent="Height"
        MaxHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="White">

    <DockPanel>

        <Border DockPanel.Dock="Bottom"
                Background="#F3F3F3"
                BorderBrush="#DDDDDD"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <Button Content="Close"
                    HorizontalAlignment="Right"
                    Padding="18,5"
                    IsDefault="True"
                    IsCancel="True"/>
        </Border>

        <StackPanel DockPanel.Dock="Top" Margin="16,16,16,10">
            <TextBlock x:Name="HeadlineText" FontSize="16"/>
            <TextBlock x:Name="DetailText"
                       Foreground="#555555"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <ScrollViewer x:Name="SkipScroller"
                      Margin="16,0,16,12"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="SkipGroups">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="{Binding Header}" FontWeight="SemiBold"/>
                            <ItemsControl ItemsSource="{Binding Lines}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   TextWrapping="Wrap"
                                                   Foreground="#444444"
                                                   Margin="14,0,0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>
</Window>
